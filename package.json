{
  "name": "portfolio-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "dev": "vite",
    "build": "vite build && node scripts/blog/build.mjs",
    "preview": "vite preview",
    "studio": "node scripts/blog/studio.mjs",
    "setup:browsers": "playwright install chromium firefox webkit",
    "setup:browsers:with-deps": "playwright install --with-deps chromium firefox webkit",
    "test": "npm run build && npm run test:unit && playwright test",
    "test:blog": "node --test test/blog*.test.mjs",
    "test:profile": "node --test test/profile.test.mjs",
    "test:unit": "npm run test:blog && npm run test:profile",
    "test:browser": "npm run build && playwright test",
    "test:smoke": "npm run build && playwright test e2e/cross-browser.spec.js"
  },
  "dependencies": {
    "markdown-it": "15.0.1",
    "three": "^0.185.1",
    "vue": "^3.5.39",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.1"
  }
}
